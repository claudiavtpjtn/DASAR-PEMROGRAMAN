        <attribute name="edited" value="SFBFbnZ5O0RFU0tUT1AtSkQ0UjNDMTsyMDI2LTA5LTI5OzA4OjA4OjMzIFBNOzE7MzAwMA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukan sebuah bilangan bulat:&quot;" newline="True"/>
            <input variable="x"/>
            <if expression="x % 2 == 0">
                <then>
                    <output expression="x &amp; &quot; bilangan genap &quot;" newline="True"/>
                </then>
                <else>
                    <output expression="x &amp; &quot; bilangan ganjil &quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
