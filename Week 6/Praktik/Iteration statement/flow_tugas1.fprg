    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, j, n" type="Integer" array="False" size=""/>
            <assign variable="n" expression="1"/>
            <output expression="&quot;Segitiga terbalik: &quot;" newline="True"/>
