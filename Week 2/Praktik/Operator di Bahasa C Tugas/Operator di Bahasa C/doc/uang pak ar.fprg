    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sabun, shampo, sabunwajah, uang, total, sisa" type="Integer" array="False" size=""/>
            <assign variable="sabun" expression="8000 * 2"/>
            <assign variable="shampo" expression="35000 * 2"/>
            <assign variable="sabunwajah" expression="39000 * 2"/>
            <assign variable="uang" expression="310000"/>
            <assign variable="total" expression="sabun + shampo + sabunwajah"/>
            <output expression="sabun" newline="True"/>
            <output expression="shampo" newline="True"/>
            <output expression="sabunwajah" newline="True"/>
            <output expression="sabun + shampo + sabunwajah" newline="True"/>
            <output expression="uang - total" newline="True"/>
        </body>
    </function>
