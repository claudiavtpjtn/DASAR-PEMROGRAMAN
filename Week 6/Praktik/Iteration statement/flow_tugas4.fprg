<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flow_tugas4"/>
        <attribute name="authors" value="Acer NIitro 5"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-18 02:44:05 PM"/>
        <attribute name="created" value="QWNlciBOSWl0cm8gNTtDTEFVREU7MjAyNi0xMC0xODswMjozNjoxNiBQTTsyODA1"/>
        <attribute name="edited" value="QWNlciBOSWl0cm8gNTtDTEFVREU7MjAyNi0xMC0xODswMjo0NDowNSBQTTsxOzI5MTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, j" type="Integer" array="False" size=""/>
            <for variable="i" start="1" end="3" direction="inc" step="1">
                <for variable="j" start="1" end="3" direction="inc" step="1">
                    <if expression="j != 2">
                        <then>
                            <if expression="i != 3">
                                <then>
                                    <output expression="i &amp; j &amp; &quot; &quot;" newline="False"/>
                                </then>
                                <else>
                                    <breakpoint expression="" always="True"/>
                                </else>
                            </if>
                        </then>
                        <else/>
                    </if>
                </for>
            </for>
        </body>
    </function>
</flowgorithm>
